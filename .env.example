# Conexión a PostgreSQL
DATABASE_URL=postgres://artesa:artesa@localhost:5432/artesa
# Clave de Gemini (opcional, con nivel gratuito): lee también lo manuscrito. Se crea en
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Clave de la API de Anthropic (opcional). Vacía = modo gratuito: el celular lee lo impreso
# y lo manuscrito se escribe a mano. LECTURA=local fuerza el modo gratuito aunque haya clave.
ANTHROPIC_API_KEY=
# LECTURA=gemini|claude|local fija el modo; sin él se usa Gemini, luego Claude, luego el local.
# LECTURA=local
# Contraseña para entrar a la aplicación (obligatoria en producción)
APP_PASSWORD=
# Opcionales
# ANTHROPIC_MODEL=claude-opus-5-5
# PORT=3000
