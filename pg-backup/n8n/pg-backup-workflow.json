    {
      "id": "a037-pgb",
      "name": "Elegir los que sobran",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3780,
        120
      ],
      "parameters": {
        "jsCode": "// Conserva los últimos N respaldos de ESTA base y manda el resto a la papelera de Drive.\n// Solo toca archivos con el nombre exacto que genera pg-backup; nunca el recién subido.\nconst cfg = $('Config').first(0).json;\nconst nuevo = $('Validar respaldo').first(0).json.archivo;\nconst retener = Number(cfg.retener);\nif (!Number.isInteger(retener) || retener < 1) throw new Error('retener debe ser un entero >= 1 (vale ' + cfg.retener + ')');\n\nconst esc = (s) => String(s).replace(/[.*+?^$(){}|[\\]\\\\]/g, '\\\\$&');\nconst patron = new RegExp('^' + esc(cfg.cliente) + '_' + esc(cfg.db) + '_\\\\d{4}-\\\\d{2}-\\\\d{2}_\\\\d{4}\\\\.dump(\\\\.age)?$');\nconst respaldos = $input.all().map((i) => i.json).filter((f) => f && f.id && patron.test(f.name || ''));\n\nif (!respaldos.some((f) => f.name === nuevo)) {\n  throw new Error('El respaldo recién subido (' + nuevo + ') no aparece en la carpeta; por seguridad no se borra nada.');\n}\n// El nombre lleva la fecha (YYYY-MM-DD_HHmm): el orden alfabético es el cronológico.\nrespaldos.sort((a, b) => (a.name < b.name ? 1 : a.name > b.name ? -1 : 0));\nreturn respaldos.slice(retener).filter((f) => f.name !== nuevo).map((f) => ({ json: { id: f.id, name: f.name } }));"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "a038-pgb",
      "name": "Enviar a papelera",
