# pg-backup · variables de entorno (un contenedor por base de datos).
# Copia los valores en el servicio de EasyPanel; NO guardes este archivo con valores reales en git.

# Identifican el respaldo y forman el nombre del archivo: {CLIENTE}_{DB_NAME}_{YYYY-MM-DD_HHmm}.dump[.age]
# Solo letras, números, punto, guion y guion bajo.
CLIENTE=ARTESA
DB_NAME=artesa-db

# External Database URL de Render (Dashboard → artesa-db → Connect → External).
# La conexión siempre usa sslmode=require (o verify-ca/verify-full si los pones en la URL).
DATABASE_URL=postgresql://usuario:clave@host.oregon-postgres.render.com:5432/base

# Token que n8n envía como "Authorization: Bearer ...". Mínimo 32 caracteres.
# Genéralo con: openssl rand -hex 32
BACKUP_TOKEN=

# Clave pública age (age1...). Si está, el respaldo sale cifrado (.dump.age). Recomendado:
# los dumps contienen datos personales. Varias claves separadas por coma.
# La clave PRIVADA nunca va al servidor ni a n8n: guárdala fuera (gestor de contraseñas).
AGE_RECIPIENT=

# Tiempo máximo de pg_dump + validación + cifrado, en segundos (10 a 21600). Por defecto 1800.
DUMP_TIMEOUT_SEC=1800

# Opcionales
# PORT=8080
# BACKUP_TZ=America/Guayaquil
